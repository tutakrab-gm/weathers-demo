# ---------- Core ----------
AUTH_SECRET=change-me-to-a-long-random-string      # openssl rand -base64 32
AUTH_URL=http://localhost:3000
AUTH_TRUST_HOST=true
APP_BASE_URL=http://localhost:3000
CRON_SECRET=change-me-cron
# บังคับโหมด mock ทุก adapter (1) หรือปล่อยว่างให้เลือกอัตโนมัติจาก credential ที่มี
FORCE_MOCK=
DEMO_DEV_LOGIN=0                                   # 1 = เปิด Dev login ใน production (ใช้ได้เฉพาะ mock หรือ AUTO_SEED=1 และ PostgreSQL จะรับเฉพาะ @example.com)

# ---------- PostgreSQL (ว่าง = mock repository เก็บที่ .data/mock-db.json) ----------
DATABASE_URL=                                      # postgres://user:pass@host:5432/dbname
DATABASE_SSL=0                                     # 1 = เปิด TLS (ผู้ให้บริการคลาวด์ส่วนใหญ่)
BOOTSTRAP_ADMIN_EMAIL=                             # ถ้าตาราง users ว่าง จะสร้าง admin คนแรกด้วยอีเมลนี้
AUTO_SEED=0                                        # 1 = ใส่ข้อมูลเดโมเมื่อตาราง users ว่าง (เฉพาะเดโม!)

# ---------- Object storage S3-compatible / Cloudflare R2 (ว่าง = เก็บรูปในดิสก์ .data/uploads) ----------
S3_ENDPOINT=                                       # เช่น https://<account>.r2.cloudflarestorage.com
S3_REGION=auto
S3_BUCKET=
S3_ACCESS_KEY_ID=
S3_SECRET_ACCESS_KEY=

# ---------- Redis (ว่าง = in-memory เฉพาะ dev / instance เดียว) ----------
REDIS_URL=

# ---------- Login providers ----------
AUTH_LINE_ID=
AUTH_LINE_SECRET=
AUTH_GOOGLE_ID=
AUTH_GOOGLE_SECRET=
SMTP_URL=                                          # smtp://user:pass@host:587 -> เปิด magic link
SMTP_FROM="ระบบสถานการณ์น้ำ <no-reply@example.com>"

# ---------- LINE Messaging API (ว่าง = mock outbox) ----------
LINE_CHANNEL_ACCESS_TOKEN=
ADMIN_LINE_USER_IDS=                               # คั่นด้วย comma (ผู้รับแจ้งเตือน admin)

# ---------- ข้อมูลหน่วยงานน้ำ (ว่าง = mock) ----------
WATER_API_BASE_URL=                                # เช่น https://api-v3.thaiwater.net/api/v1/thaiwater30/public

# ---------- Chat ----------
ANTHROPIC_API_KEY=
CLAUDE_MODEL=claude-sonnet-5-5

# ---------- Jobs ----------
ENABLE_INTERNAL_CRON=0                             # 1 = ใช้ node-cron ในโปรเซสแอป (instance เดียวเท่านั้น)
